<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:TreeVisualizer.App"
        x:Class="TreeVisualizer.App.MainWindow"
        Title="Tree Visualizer" Width="1400" Height="900" MinWidth="900" MinHeight="600">
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,10,0,4"/>
      <Setter Property="Opacity" Value="0.85"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Left: data and view controls -->
    <Border DockPanel.Dock="Left" Width="290" BorderThickness="0,0,1,0" BorderBrush="#22000000">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="4">
          <TextBlock Classes="h" Text="Data" Margin="0,0,0,4"/>
          <Button x:Name="OpenButton" Content="Open tree…" Click="OnOpen"/>
          <Button x:Name="CompareButton" Content="Diff against older snapshot…" Click="OnCompare" IsEnabled="False"/>
          <Button x:Name="ClearDiffButton" Content="Clear diff" Click="OnClearDiff" IsVisible="False"/>
          <CheckBox x:Name="SideBySideBox" Content="Side by side (before | after)" IsVisible="False"
                    ToolTip.Tip="Show the older and newer snapshots next to each other with linked pan, zoom and hover"/>
          <Button x:Name="SampleButton" Content="Load synthetic sample (10k + diff)" Click="OnSample"/>
          <TextBlock x:Name="FileInfo" TextWrapping="Wrap" FontSize="12" Opacity="0.75"/>

          <TextBlock Classes="h" Text="View"/>
          <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Grid.Row="0" Text="Layout" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="LayoutBox" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="Radial tree"/>
              <ComboBoxItem Content="Sunburst"/>
              <ComboBoxItem Content="Cascade tree" ToolTip.Tip="Radial tree with each manager in line with their first report; later reports follow clockwise"/>
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Color" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="ColorBox" HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Row="2" Text="Sort" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SortBox" HorizontalAlignment="Stretch"/>
            <TextBlock Grid.Row="3" Text="Depth" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="DepthBox" Minimum="0" Maximum="50" Value="0"
                           FormatString="0" PlaceholderText="all" ToolTip.Tip="Levels below the center node (0 = all)"/>
            <TextBlock Grid.Row="4" Text="Balance" VerticalAlignment="Center"
                       ToolTip.Tip="Wedge size ∝ headcount^balance. Lower values give small teams more room."/>
            <Slider Grid.Row="4" Grid.Column="1" x:Name="AlphaSlider" Minimum="0.3" Maximum="1" Value="1"/>
            <TextBlock Grid.Row="5" Text="Labels" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="LabelModeBox" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="Where they fit"/>
              <ComboBoxItem Content="All (shrink to fit)"/>
              <ComboBoxItem Content="None"/>
            </ComboBox>
            <TextBlock Grid.Row="6" Text="Stagger" VerticalAlignment="Center"
                       ToolTip.Tip="Spread crowded groups of leaf reports over sub-rings (radial and cascade layouts)"/>
            <ComboBox Grid.Row="6" Grid.Column="1" x:Name="StaggerBox" HorizontalAlignment="Stretch" SelectedIndex="0">
              <ComboBoxItem Content="Off"/>
              <ComboBoxItem Content="2 sub-rings"/>
              <ComboBoxItem Content="3 sub-rings"/>
            </ComboBox>
          </Grid>

          <TextBlock Classes="h" Text="Label keys"/>
          <ListBox x:Name="LabelKeysBox" SelectionMode="Multiple,Toggle" MaxHeight="160"/>

          <TextBlock Classes="h" Text="Annotation rings" ToolTip.Tip="One colored ring per selected key, outside the tree"/>
          <ListBox x:Name="RingKeysBox" SelectionMode="Multiple,Toggle" MaxHeight="160"/>

          <TextBlock Classes="h" Text="Search"/>
          <TextBox x:Name="SearchBox" PlaceholderText="Name, id or any value…"/>
          <TextBlock x:Name="SearchInfo" FontSize="12" Opacity="0.75"/>
          <ListBox x:Name="SearchResults" MaxHeight="180"/>

          <TextBlock Classes="h" Text="Export"/>
          <Grid ColumnDefinitions="80,*" RowSpacing="6">
            <TextBlock Text="Size (px)" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" x:Name="ExportSizeBox" Minimum="256" Maximum="40000" Value="4000"
                           Increment="500" FormatString="0"/>
          </Grid>
          <Button Content="Export current view…" Click="OnExport"
                  ToolTip.Tip="Exports the current center node, depth, layout, colors and labels as PNG, PDF or SVG"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- Right: inspector and legend -->
    <Border DockPanel.Dock="Right" Width="290" BorderThickness="1,0,0,0" BorderBrush="#22000000">
      <ScrollViewer>
        <StackPanel Margin="12" Spacing="4">
          <TextBlock Classes="h" Text="Center" Margin="0,0,0,4"/>
          <WrapPanel x:Name="Breadcrumbs"/>
          <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
            <Button Content="Up one level" Click="OnUp" HorizontalAlignment="Left"/>
            <Button Content="Fit" Click="OnFit" HorizontalAlignment="Left"/>
          </StackPanel>

          <TextBlock Classes="h" Text="Node"/>
          <TextBlock x:Name="Inspector" TextWrapping="Wrap" FontSize="12" Text="Hover or click a node."/>
          <Button x:Name="FocusButton" Content="Make this the center" Click="OnFocusSelected" IsVisible="False"/>

          <TextBlock Classes="h" x:Name="LegendTitle" Text="Legend"/>
          <ItemsControl x:Name="LegendItems">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="local:LegendRow">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                  <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="h" Text="Outline"/>
          <ListBox x:Name="OutlineList" Height="340" SelectionMode="Single" FontSize="12">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="2,1"/>
                <Setter Property="MinHeight" Value="0"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:OutlineRow">
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                  <Button Content="{Binding Glyph}" Tag="{Binding}" Click="OnOutlineToggle" IsVisible="{Binding HasChildren}"
                          Width="18" Height="18" Padding="0" FontSize="10" Background="Transparent" BorderThickness="0"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                  <Border Width="18" IsVisible="{Binding !HasChildren}"/>
                  <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,5,0" Background="{Binding Marker}"
                          VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock x:Name="Status" FontSize="11" Opacity="0.6" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Grid x:Name="CanvasGrid" ColumnDefinitions="*,*">
      <DockPanel x:Name="OldPanel" Grid.Column="0" IsVisible="False">
        <Border DockPanel.Dock="Top" Background="#10000000" Padding="8,4" BorderThickness="0,0,1,0" BorderBrush="#22000000">
          <TextBlock x:Name="OldCaption" FontWeight="SemiBold" FontSize="12"/>
        </Border>
        <Border BorderThickness="0,0,1,0" BorderBrush="#22000000">
          <local:TreeCanvas x:Name="OldCanvas"/>
        </Border>
      </DockPanel>
      <DockPanel x:Name="MainPanel" Grid.Column="0" Grid.ColumnSpan="2">
        <Border x:Name="MainCaptionBar" DockPanel.Dock="Top" Background="#10000000" Padding="8,4" IsVisible="False">
          <TextBlock x:Name="MainCaption" FontWeight="SemiBold" FontSize="12"/>
        </Border>
        <local:TreeCanvas x:Name="Canvas"/>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
